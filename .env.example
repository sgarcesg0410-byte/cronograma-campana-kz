# ==============================================================================
# VARIABLES DE ENTORNO - CRONOGRAMA CAMPAÑA #VOY CON EL KZ
# ==============================================================================
# Copie este archivo como '.env' para desarrollo local o configure estas variables
# en el panel de su proveedor de hosting (Render, Railway, Fly.io, etc.).
# ==============================================================================

# ENTORNO Y PUERTO
NODE_ENV=production
PORT=5000

# SEGURIDAD Y SESIONES (CRÍTICO)
# En producción (NODE_ENV=production), JWT_SECRET es ESTRICTAMENTE OBLIGATORIO.
# Genere un secreto criptográfico seguro (mínimo 32 caracteres):
# En terminal: openssl rand -base64 32
JWT_SECRET=reemplazar_con_un_secreto_seguro_de_minimo_32_caracteres_aleatorios

# BASE DE DATOS
# Ruta al archivo SQLite persistente. En Docker o Render Disk, asegúrese de apuntar
# al volumen montado (ej: /var/data/campana.sqlite).
DATABASE_FILE=server/campana.sqlite

# NOTIFICACIONES WHATSAPP
# Proveedor por defecto: 'assisted' (enlaces manuales wa.me), 'meta', 'twilio', o 'evolution'
WHATSAPP_PROVIDER=assisted

# Número principal de la campaña / candidato para recibir alertas automáticas en formato E.164
WHATSAPP_NOTIFY_NUMBER=+573001234567

# ------------------------------------------------------------------------------
# CONFIGURACIÓN OPCIONAL: META WHATSAPP CLOUD API (Oficial)
# ------------------------------------------------------------------------------
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# CONFIGURACIÓN OPCIONAL: TWILIO WHATSAPP
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ------------------------------------------------------------------------------
# CONFIGURACIÓN OPCIONAL: EVOLUTION API (Servidor WhatsApp propio / QR)
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
